{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gilula.vercel.app"
        }
      ],
      "dest": "/api/canonical"
    },
    {
      "src": "^/_shell/article$",
      "dest": "/article.html"
    },
    {
      "src": "^/article\\.html$",
      "dest": "/api/og"
    },
    {
      "handle": "filesystem"
    }
  ]
}
