{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "images": {
    "sizes": [320, 640, 960, 1280],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "nsyvkietzqurythnxurs.supabase.co",
        "pathname": "/storage/v1/object/public/**"
      }
    ],
    "minimumCacheTTL": 31536000,
    "formats": ["image/webp"]
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(gilula\\.vercel\\.app|gilula\\.ge|www\\.gilula\\.ge|www\\.arenageo\\.ge)$"
        }
      ],
      "dest": "/api/canonical"
    },
    {
      "src": "^/_shell/article$",
      "dest": "/article.html"
    },
    {
      "src": "^/article\\.html$",
      "dest": "/api/og"
    },
    {
      "handle": "filesystem"
    }
  ]
}
